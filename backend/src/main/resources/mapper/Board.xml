<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.com.backend.mapper.BoardMapper">

    <select id="selectBoardList" resultType="kr.com.backend.vo.BoardVO">
        SELECT
            BOARD_NO
             , TITLE
             , CONTENT
             , WRITER
             , REG_DT
        FROM
            TB_BOARD
    </select>

</mapper>