<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.com.backend.mapper.BoardMapper">

    <!-- 게시판 리스트 -->
    <select id="selectBoardList" resultType="kr.com.backend.vo.BoardVO">
        SELECT
            BOARD_NO
             , TITLE
             , CONTENT
             , WRITER
             , REG_DT
        FROM
            TB_BOARD
    </select>

    <!-- 게신판 상세보기 -->
    <select id="selectBoard" resultType="kr.com.backend.vo.BoardVO">
        SELECT
            BOARD_NO
             , TITLE
             , CONTENT
             , WRITER
             , REG_DT
        FROM
            TB_BOARD
        WHERE
            BOARD_NO = #{boardNo}
    </select>


</mapper>